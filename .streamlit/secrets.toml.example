# Copy these values into Streamlit Cloud > App settings > Secrets.
# Generate your own Fernet key. Never commit the real secrets file.

UPLOAD_ENCRYPTION_KEY = "REPLACE_WITH_GENERATED_FERNET_KEY"

GROQ_API_KEY = "YOUR_GROQ_API_KEY"
GROQ_MODEL = "openai/gpt-oss-120b"

GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "gemini-4-hydrogen"
# If the selected model fails, the app tries these in order.
GEMINI_FALLBACK_MODELS = "gemini-4-carbon,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview"
